# 仪表在宿主机上的监听地址。填 N100 的局域网地址（例如 192.168.2.50）
# 可以避免其它网卡也被打开。0.0.0.0 表示这台机器上的所有地址。
# 不要在路由器上把这个端口转发到公网。
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8080

# 路由器原点，不要写用户名、密码，也不要带 /rest。
# 纯 HTTP 的 www 需要 RouterOS 7.9 及以上。更稳妥的是 https://192.168.2.1（www-ssl）。
ROUTEROS_HOST=http://192.168.2.1
ROUTEROS_USER=dashboard
ROUTEROS_PASSWORD=change-me

# 仅当使用 https 且证书是路由器自签时设为 true。不要据此把仪表暴露到公网。
ROUTEROS_TLS_INSECURE=false

# 逗号分隔。互联网吞吐优先取其中的 PPPoE 接口（默认 liantong），不会把 ether0 再加一遍。
WAN_INTERFACES=liantong,ether0
LAN_INTERFACES=bridge1

# 路由器暂时连不上、只想看界面时设为 true。页面会一直标明这是演示数据。
DEMO_MODE=false

# 写操作默认关闭。启用必须使用单独的 RouterOS 用户，具备 read,rest-api,write 权限。
# 不要复用或升级只读 dashboard 用户；绝不授予 policy / sensitive / password。
# 仅限局域网使用，绝不要暴露公网。
ROS_WRITE_ENABLED=false

# 可选。单次 REST 读取超时，毫秒，限制在 1000–20000。
# ROUTEROS_TIMEOUT_MS=8000
