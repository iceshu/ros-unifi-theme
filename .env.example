# 仪表在宿主机上的监听地址。填服务器的局域网地址（例如 192.168.1.100）
# 可以避免其它网卡也被打开。0.0.0.0 表示这台机器上的所有地址。
# 不要在路由器上把这个端口转发到公网。
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8080

# 路由器原点，不要写用户名、密码，也不要带 /rest。
# 纯 HTTP 的 www 需要 RouterOS 7.9 及以上。更稳妥的是 https://<路由器地址>（www-ssl）。
ROUTEROS_HOST=http://192.168.1.1

# 页面登录使用你自己的 RouterOS 账号，能做什么由该账号所在组的权限决定。
# 下面这组账号是可选的“后台账号”，给流量采样、告警检查、定时配置备份和更新检查用。
# 只要采样和告警：只读组 read,api,rest-api 即可；
# 还要定时备份：需要 read,write,ftp,test,api,rest-api（/export 写文件、读文件再删除）。
# 不填时，后台任务借用最近活跃的登录会话，没人登录时暂停。
ROUTEROS_USER=
ROUTEROS_PASSWORD=

# 仅当使用 https 且证书是路由器自签时设为 true。不要据此把仪表暴露到公网。
ROUTEROS_TLS_INSECURE=false

# 逗号分隔，按你的实际接口填。互联网吞吐优先取其中的 PPPoE 接口，不会把拨号的物理口再加一遍。
WAN_INTERFACES=pppoe-out1,ether1
LAN_INTERFACES=bridge

# 路由器暂时连不上、只想看界面时设为 true。页面会一直标明这是演示数据。
DEMO_MODE=false

# 登录会话闲置多久失效（小时），默认 12。
# SESSION_TTL_HOURS=12

# 可选。单次 REST 读取超时，毫秒，限制在 1000–20000。
# ROUTEROS_TIMEOUT_MS=8000

# 吞吐历史采样，默认 true；设为 false 时 /api/history 返回 404，不占内存。
# HISTORY_ENABLED=true

# 历史采样间隔，毫秒，限制在 2000–60000。调大可减少内存和路由器请求频率。
# HISTORY_INTERVAL_MS=5000

# 数据目录：设置、告警、审计记录、30 天流量和配置备份存成一个 SQLite 文件。
# Docker 里固定为 /app/data（docker-compose 已挂卷），本地开发默认 ./data。
# DATA_DIR=./data
